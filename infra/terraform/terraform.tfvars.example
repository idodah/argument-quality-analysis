# Copy to terraform.tfvars (gitignored) and fill in. This is the single source of
# truth for every value an operator must provide. Anything not listed has a
# sensible default in variables.tf and need not be set.
#
#   cp terraform.tfvars.example terraform.tfvars
#   # edit terraform.tfvars, then: terraform apply  (it's auto-loaded)

# ── REQUIRED (no default) ──────────────────────────────────────────────────

# S3 URI of the packaged Qwen ranker (build with infra/sagemaker/package_model.sh).
# The bucket is created by this stack, so do the phase-1 apply + upload first
# (see infra/DEPLOY.md §1–3), then set this.
ranker_model_s3_uri = "s3://cmv-harvester-ranker-<ACCOUNT_ID>/model/model.tar.gz"

# SageMaker PyTorch GPU inference DLC image whose torch matches uv.lock (2.11.x),
# in your region. From the AWS Deep Learning Containers list.
ranker_image_uri = "<ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/pytorch-inference:2.11-gpu-py311"

# Where budget-threshold alerts go.
budget_alert_email = "you@example.com"

# ── REGION + MODEL (defaults exist, but VERIFY for your region) ─────────────

# Must be a region where Bedrock Nova 2 Lite is available. NOTE: outside us-east-1
# / us-west-2, Nova is usually reachable only via a CROSS-REGION INFERENCE PROFILE
# — in the EU that means region eu-west-1 AND the "eu."-prefixed model id below.
region = "eu-west-1"

# In us-east-1/us-west-2 the bare id works: "amazon.nova-2-lite-v1:0".
# In the EU you almost certainly need the inference-profile id:
bedrock_model_id = "eu.amazon.nova-2-lite-v1:0"

# ── OPTIONAL OVERRIDES (defaults in variables.tf) ──────────────────────────

# name_prefix          = "cmv-harvester"      # prefix for all resource names
# schedule_expression  = "rate(1 hour)"       # how often the harvester runs
# ranker_instance_type = "ml.g5.2xlarge"      # GPU for the async endpoint
# monthly_budget_usd   = 100                  # Bedrock+SageMaker budget alarm
# task_cpu             = 1024
# task_memory          = 2048
# vpc_cidr             = "10.20.0.0/16"
# create_openai_secret = true                 # embeddings stay on OpenAI

# ── CI / OIDC ──────────────────────────────────────────────────────────────

# github_repo                 = "idodah/argument-quality-analysis"
# github_oidc_provider_exists = false   # set true if the account already has the
#                                       # token.actions.githubusercontent.com provider

# ── NOT a Terraform input (so you don't go looking) ────────────────────────
# AWS_ACCOUNT_ID  — derived automatically (aws_caller_identity); never set it.
# *_REGION (BEDROCK_REGION/SAGEMAKER_REGION/DDB_REGION) — the code falls back to
#                   AWS_REGION, which the task definition sets from `region`.
# Secret VALUES (Tavily/ntfy/OpenAI keys) — set via `aws secretsmanager
#                   put-secret-value` after apply (DEPLOY.md §5), NEVER here.
