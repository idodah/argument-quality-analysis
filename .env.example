# Copy to `.env` and fill in. `.env` is gitignored; this template is not.

# --- Required for generation (CLI, web app, agentic graph) ---
OPENAI_API_KEY=

# Fine-tuned Qwen pair-wise ranker: a local checkpoint dir or an HF repo id
# (e.g. ./checkpoints/qwen_qlora_rank/final). Needed by the agentic graph.
RANKER_PATH=

# --- Optional ---
TAVILY_API_KEY=        # enables the web-search retrieval arm
HF_TOKEN=              # dataset/model uploads and gated model/tokenizer access

# Observability (opt-in; no-op unless set) — LangSmith traces the agentic graph.
LANGSMITH_TRACING=     # set to "true" to enable
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=     # optional, e.g. argument-quality

# Weights & Biases logs the Qwen QLoRA fine-tuning run.
WANDB_API_KEY=
WANDB_PROJECT=         # optional, e.g. qwen-qlora-ranker

# Pin the retrieval route for debugging the graph: "local" or "web".
FORCE_RETRIEVAL_MODE=
