# Claude Code: commit the shared project config (settings.json, commands/) but
# keep machine-local overrides and transient state out of the repo.
.claude/settings.local.json
.claude/*.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/skills/

# CLI entrypoint (local-only)
run.py

# Local-only: Gradio web app, internal guidance, and security notes
webapp/
CLAUDE.md
SECURITY.md


# Local-only docs folder (the published graph lives at repo root: graph.png)
docs/

# Harvester runtime artifacts (the harvester/ source itself IS tracked)
harvester_tracking.db
harvester_responses.jsonl
harvester_orch.log

# Terraform local state / provider cache (the .tf source + .terraform.lock.hcl
# provider lock ARE tracked; everything below is local-only or secret).
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Local-only infra docs (operator notes / deploy runbook)
infra/terraform/README.md
infra/sagemaker/README.md
infra/DEPLOY.md

